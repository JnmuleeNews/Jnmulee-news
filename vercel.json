    },
    {
      "path": "/api/fetch-news?batch=1",
      "schedule": "10 */6 * * *"
    },
    {
      "path": "/api/fetch-news?batch=2",
      "schedule": "20 */6 * * *"
    },
    {
      "path": "/api/fetch-news?batch=3",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/fetch-news?batch=4",
